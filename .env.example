# Copy to .env and replace the passwords (letters and digits only: they are placed in a URL).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace_with_a_local_password
MONGO_APP_USER=dispora_app
MONGO_APP_PASSWORD=replace_with_another_local_password
MONGO_PORT=57017

# Redis cache. false = every request reads MongoDB directly (the site still works).
CACHE_ENABLED=true
CACHE_TTL_DETAIL=3600
CACHE_TTL_LIST=300

# Empty = PATCH endpoints disabled.
ADMIN_TOKEN=

WEB_PORT=8080
